<div class="{{#if classes}}{{this.classes}} {{/if}}modal-cooperation">
  <div class="modal-cooperation__bg-image">
    <img src="../../assets/images/spider.webp" alt="">
  </div>
  
  <div class="modal-cooperation__wrapper">
    <p class="heading heading_h3 modal-cooperation__title">Заполните форму и мы вам перезвоним</p>

    <form action="" class="modal-cooperation__form">
      <div class="modal-cooperation__variant">
        <span class="text">Выберите вариант сотрудничества</span>

        <div class="modal-cooperation__variant-radio radio-group radio-group_row">
          {{> elements/radio
            classes='radio-group__item modal-cooperation__variant-radio-item'
            name='option-of-cooperation'
            id='ambassador'
            value='ambassador'
            text='амбассадор'
            checked=true
          }}
          
          {{> elements/radio
            classes='radio-group__item modal-cooperation__variant-radio-item'
            name='option-of-cooperation'
            id='partner'
            value='partner'
            text='клиника партнер'
          }}
          
          {{> elements/radio
            classes='radio-group__item modal-cooperation__variant-radio-item'
            name='option-of-cooperation'
            id='doctor'
            value='doctor'
            text='врач клиники'
          }}
        </div>
      </div>
    </form>
  </div>
</div>
