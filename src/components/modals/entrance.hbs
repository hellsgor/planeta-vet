<form data-form-auto-init="" action="/data/success.json" method="POST" name="entrance" class="{{#if classes}}{{this.classes}} {{/if}}modal-entrance">
  <h6 class="modal-entrance__title">Вход</h6>
  <div class="modal-entrance__controls">
    {{> elements/form-control
      classes='modal-entrance__control'
      small=false
      white=false
      id='entrance-email'
      type='email'
      placeholder='Email'
      name='email'
      required=true
      autocomplete='email'
    }}
    
    {{> elements/form-control
      classes='modal-entrance__control'
      small=false
      white=false
      id='entrance-password'
      type='password'
      placeholder='Пароль'
      name='password'
      required=true
      autocomplete='current-password'
    }}
  </div>

  <div class="modal-entrance__buttons">
    {{> elements/button classes='button_white_bordered modal-entrance__enter-button' white=true bordered=true type='submit' text='Войти'}}
  
    {{> elements/button classes='button_null modal-entrance__forgot' type='button' text='Забыли пароль?' attrs='data-call-modal="forgot"'}}
  </div>
</form>
