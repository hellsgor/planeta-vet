<form data-form-auto-init="" action="/data/recovery.json" method="POST" name="recovery" class="{{#if classes}}{{this.classes}} {{/if}}modal-forgot">
  <h6 class="modal-forgot__title">Восстановление пароля</h6>

  {{> elements/form-control
      classes='modal-forgot__control'
      small=false
      white=false
      id='new-password-email'
      type='email'
      placeholder='Email'
      name='new-password-email'
      require=true
      autocomplete='off'
    }}

  {{> elements/button classes='button_white_bordered modal-forgot__restore-button' white=true bordered=true type='submit' text='Восстановить'}}
</form>
