<div class="{{#if this.classes}}{{this.classes}} {{/if}}stage">
  <div class="stage__icon">
    <svg>
      <use xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="#{{this.iconId}}" />
    </svg>
  </div>

  <div class="stage__content">
    <h6 class="stage__title">{{this.title}}</h6>
    <p class="stage__description">{{this.description}}</p>
  </div>
</div>
