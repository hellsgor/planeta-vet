<header class="{{#if this.classes}}{{this.classes}} {{/if}}section-header">
  <h2 class="section-header__title{{#if this.numbered}} section-header__title_numbered {{#if this.accent-color}} section-header__title_{{this.accent-color}}{{else}} section-header__title_orange{{/if}}{{/if}}">{{this.title}}</h2>

  {{#if this.subtitle}}
    <p class="section-header__subtitle">{{this.subtitle}}</p>
  {{/if}}
</header>
