<section class="accordion">
  <div class="container">
    {{> section-header numbered="true" classes="accordeon-section-header" title="Часто спрашивают" accent-color=this.accentColor}}

    <ul class="accordion-list">
      {{#each this.list}}
         {{> accordion-item this}}
      {{/each}}
   
    </ul>

  </div>
</section>
