<section class="approaches">
  <div class="container approaches__container">
    {{> section-header numbered="true" classes="approaches__section-header" title="3 концепции" subtitle="Каждая из этих концепций может быть адаптирована под ваши потребности"}}

    <div class="approaches__cards">
      {{#each this.approaches.card}}
        {{> approaches-card data=approaches}}
      {{/each}}

      <div class="approaches__decor">
        {{> elements/shadow-circle classes='approaches__shadow'}}
        <img src="/images/hamster.webp" alt="">
        {{> message classes="approaches__message" position="right-top" text="Мы предлагаем уникальные возможности для франчайзи."}}
      </div>
    </div>

  </div>
</section>
