<section class="concept">
  <div class="container">
    {{> section-header numbered="true" classes="section-header__concept" title="PlanetaVet" subtitle="Это клиентоориентированные ветеринарные клиники с высокоточным лабораторным оборудованием для диагностики и лучшие ветеринарные врачи"}}

    {{!-- {{> message classes="concept-message" position="right-top" text="У нас более 500 видов исследований. И мы постоянно обновляем каталог"}} --}}

    <div class="concept__wrapper">

  
  {{> rounded-img classes="concept__img" src="/assets/images/concept-planeta-vet.webp"}}

