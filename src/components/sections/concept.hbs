


<section class="concept">
  <div class="concept__decor-wrapper">
      <div class="concept__decor">
                <img src="/assets/images/frog.webp" alt="">
      </div>
  </div>


  <div class="container">
    {{> section-header numbered="true" classes="concept-section-header" title="PlanetaVet" subtitle="Это клиентоориентированные ветеринарные клиники с высокоточным лабораторным оборудованием для диагностики и лучшие ветеринарные врачи"}}

    {{> message classes="concept__message" position="right-top" text="У нас более 500 видов исследований. И мы постоянно обновляем каталог"}}
    {{> elements/shadow-circle classes='concept__shadow'}}

    <div class="concept__wrapper">
    {{> elements/shadow-circle classes='concept__shadow'}}

  
  {{> rounded-img classes="concept__img" src="/assets/images/concept-planeta-vet.webp"}}

    <div class="services concept__services">
      <h6>Ветеринарные услуги</h6>
      <ul class="custom custom_plus">
       {{#each data.services}}
       <li>{{this.name}}</li>
       {{/each}}
      </ul>
      {{> elements/button href="/services.html" text="Перейти в каталог" classes="button_white" }}
    </div>

    </div>

    
  </div>
</section>
