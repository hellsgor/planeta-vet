<section class="join">
  <div class="join__decor-wrapper">
      <div class="join__decor">
                <img src="/images/chameleon.webp" alt="">
      </div>
    </div>
  <div class="container">
        {{> message classes="join__message" position="left-top" text="У нас более 500 видов исследований. И мы постоянно обновляем каталог"  listClasses="join-list"  list=join.list}}
    
<div class="join__wrapper">
        <h5>Присоединяйтесь к успешной сети и станьте частью команды, которая заботится о здоровье и благополучии животных</h5>
        {{> elements/button type='button' text="Стать партнером" attrs='popovertarget="modal-cooperation"' classes='join__partner-button'}}
</div>
    {{> elements/shadow-circle classes='join__shadow'}}
    {{> elements/shadow-circle classes='join__shadow'}}
    </div>
</section>
