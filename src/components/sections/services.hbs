<div class="services">
  <div class="container services__container">
    <h2 class="services__heading">Анализы</h2>

    <div class="services__wrapper">
      <div class="services__catalog" data-tab-parent="">
        <div class="services__tabs">
          {{#each this}}
            <a href="#{{this.name}}" class="services__tab" data-tab="{{this.name}}">
              <span>{{this.heading}}</span>
            </a>
          {{/each}}
        </div>

        <div class="services__items-wrapper">
          {{#each this}}
            <ul class="custom custom_plus services__items" data-tab-content="{{this.name}}">
              {{#each this.items}}
                <li class="services__item"><a href="#{{this.name}}">{{{this.nameRu}}}</a></li>
              {{/each}}
            </ul>
          {{/each}}
        </div>
      </div>
      
      <div class="services__service-content">
      </div>
    </div>
  </div>
</div>


