<section class="stages-of-opening">
  <div class="container stages-of-opening__container">
    {{> section-header
      classes='stages-of-opening__header'
      numbered=true
      accent-color='orange'
      title=this.title
      subtitle=this.subtitle
    }}

    <div class="stages-of-opening__list stages-list">
      {{#each this.stages}}
        {{> stage this classes='stages-of-opening__item'}}
      {{/each}}
    </div>

    {{> elements/shadow-circle classes='stages-of-opening__shadow-circle'}}
    {{> rounded-img classes='stages-of-opening__rounded-img' src='images/stages-of-opening.webp'}}
    <div class="stages-of-opening__decor">
      <div class="stages-of-opening__decor-image">
        <img src="../../assets/images/parrot-stages.webp" alt="">
      </div>

      {{> message classes='stages-of-opening__message' position='right-top' text=this.message}}
    </div>
  </div>
</section>
