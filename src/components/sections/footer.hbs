<!-- footer start -->
<footer class="footer">
  <div class="footer__logo footer__logo-text">
    <img src="../../assets/images/footer-logo-text.svg" alt="">
  </div>

  <div class="footer__logo footer__logo-image">
    <img src="../../assets/images/footer-logo-image.svg" alt="">
  </div>

  <div class="container footer__container">
    <div class="footer__columns">
      <div class="footer__column footer__contacts">
        <address class="footer__address">
          {{#each data.contacts}}
            {{> elements/button classes='button_underlined button_empty footer__contact' href=this.href text=this.text}}
          {{/each}}
        </address>
        {{#each data.social}}
          {{> elements/button classes='button_empty button_external-link footer__social' href=this.href text=this.text iconId=this.iconId}}
        {{/each}}
      </div>

      <nav class="footer__column footer__navigation">
        {{#each data.navigation}}
          {{> elements/button empty='true' href=this.href text=this.text}}
        {{/each}}
      </nav>
    </div>

    <div class="footer__bottom-row">
      <span class="footer__copyright">©2024</span>
    </div>
  </div>
</footer>
<!-- footer end -->
