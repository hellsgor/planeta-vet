<section class="countdown" data-time="20.12.2025">
  <div class="container">
    <div class="countdown__card">
    <h5>До конца регистрации в программе осталось</h5>
    <div class="countdown__timer">
      <div class="countdown__timer-block">
        <span class="countdown__timer-time countdown-days"></span>
        <span class="countdown__timer-name">дней</span>
      </div>

      <div class="countdown__timer-block">
        <span class="countdown__timer-time countdown-hours"></span>
        <span class="countdown__timer-name">часа</span>
      </div>

      <div class="countdown__timer-block">
        <span class="countdown__timer-time countdown-minutes"></span>
        <span class="countdown__timer-name">минут</span>
      </div>
    </div>
      {{> elements/button text="Стать партнёром" white=true attrs='data-call-modal="cooperation"'}}
 

      {{> message text="Успей присоединиться к нашей партнёрской программе" position="right-top" classes="countdown__message"}}

      <img class="countdown__img" src="/images/{{#if this.image}}{{this.image}}{{else}}countdown.webp{{/if}}" alt="">
    </div>
    </div>
</section>
