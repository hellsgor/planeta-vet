<div class="form-control{{#if this.classes}} {{this.classes}}{{/if}}">
  <input 
    class="form-control__input"
    {{#if this.type}}type="{{this.type}}"{{else}} type="text"{{/if}} 
    {{#if this.inputmode}}inputmode="{{this.inputmode}}"{{/if}} 
    {{#if this.placeholder}} placeholder="{{this.placeholder}}{{#if this.require}}*{{/if}}"{{/if}}
    {{#if this.id}} id="{{this.id}}"{{/if}}
    {{#if this.name}} name="{{this.name}}"{{/if}}
    {{#if this.require}} require{{/if}}
    {{#if this.autocomplete}} autocomplete="{{this.autocomplete}}"{{/if}}
  >
  <p class="form-control__error"></p>
</div>
